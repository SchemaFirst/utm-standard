{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.schemafirst.org/schemas/utm-source.schema.json",
  "title": "SchemaFirst UTM Source Record",
  "description": "A canonical source record in the SchemaFirst UTM Source Registry.",
  "type": "object",
  "required": [
    "id",
    "registry-version",
    "status",
    "display-name",
    "canonical-source",
    "aliases",
    "category",
    "contexts",
    "provenance",
    "references"
  ],
  "additionalProperties": false,
  "$defs": {
    "token": {
      "type": "string",
      "pattern": "^[a-z0-9]+(_[a-z0-9]+)*$"
    },
    "provenance-class": {
      "enum": [
        "google-defined",
        "schemafirst-default",
        "organization-defined"
      ]
    }
  },
  "properties": {
    "$schema": {
      "type": "string",
      "format": "uri"
    },
    "id": {
      "$ref": "#/$defs/token"
    },
    "registry-version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "status": {
      "enum": [
        "draft",
        "open-for-comment",
        "published",
        "deprecated"
      ]
    },
    "display-name": {
      "type": "string",
      "minLength": 1
    },
    "canonical-source": {
      "$ref": "#/$defs/token"
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "category": {
      "enum": [
        "search",
        "social",
        "video",
        "email",
        "sms",
        "display",
        "referral",
        "affiliate",
        "audio",
        "other"
      ]
    },
    "contexts": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "$ref": "#/$defs/token"
      },
      "additionalProperties": {
        "type": "object",
        "required": [
          "description",
          "utm_medium",
          "intended-google-channel"
        ],
        "additionalProperties": false,
        "properties": {
          "description": {
            "type": "string"
          },
          "utm_medium": {
            "$ref": "#/$defs/token"
          },
          "intended-google-channel": {
            "type": "string"
          }
        }
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "provenance": {
      "type": "object",
      "required": [
        "canonical-source",
        "explanation"
      ],
      "properties": {
        "explanation": {
          "type": "string"
        }
      },
      "additionalProperties": {
        "$ref": "#/$defs/provenance-class"
      }
    },
    "references": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uri"
      }
    }
  }
}
