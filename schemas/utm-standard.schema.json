{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.schemafirst.org/schemas/utm-standard.schema.json",
  "title": "SchemaFirst UTM Standard",
  "description": "Structure of the SchemaFirst UTM Standard document.",
  "type": "object",
  "required": [
    "$id",
    "name",
    "id",
    "version",
    "status",
    "repository",
    "inputs",
    "parameters",
    "minimum-conforming-set",
    "campaign-naming",
    "url-assembly",
    "generation",
    "provenance-classes",
    "organization-profile",
    "versioning",
    "sources",
    "references"
  ],
  "$defs": {
    "requirement": {
      "enum": [
        "required",
        "recommended",
        "optional",
        "prohibited"
      ]
    },
    "parameter-name": {
      "enum": [
        "utm_source",
        "utm_medium",
        "utm_campaign",
        "utm_id",
        "utm_source_platform",
        "utm_content",
        "utm_term",
        "utm_creative_format",
        "utm_marketing_tactic"
      ]
    },
    "parameter": {
      "type": "object",
      "required": [
        "name",
        "requirement",
        "value-source",
        "derivation",
        "semantics",
        "default-basis",
        "overridable",
        "google-meaning"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "$ref": "#/$defs/parameter-name"
        },
        "requirement": {
          "$ref": "#/$defs/requirement"
        },
        "value-source": {
          "type": "string"
        },
        "derivation": {
          "type": "string"
        },
        "semantics": {
          "const": "google-defined"
        },
        "default-basis": {
          "enum": [
            "google-defined",
            "schemafirst-default"
          ]
        },
        "overridable": {
          "enum": [
            false,
            "requirement",
            "sources-only"
          ]
        },
        "google-meaning": {
          "type": "string"
        },
        "applies-when": {
          "type": "string"
        }
      }
    },
    "token": {
      "type": "string",
      "pattern": "^[a-z0-9]+(_[a-z0-9]+)*$"
    },
    "provenance-class": {
      "enum": [
        "google-defined",
        "schemafirst-default",
        "organization-defined"
      ]
    },
    "source": {
      "type": "object",
      "description": "One source. Its key in `sources` equals its `canonical-source`.",
      "required": [
        "display-name",
        "canonical-source",
        "aliases",
        "category",
        "contexts",
        "provenance",
        "references"
      ],
      "additionalProperties": false,
      "properties": {
        "display-name": {
          "type": "string",
          "minLength": 1
        },
        "canonical-source": {
          "$ref": "#/$defs/token"
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "category": {
          "enum": [
            "search",
            "social",
            "video",
            "email",
            "sms",
            "display",
            "referral",
            "affiliate",
            "audio",
            "other"
          ]
        },
        "contexts": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "$ref": "#/$defs/token"
          },
          "additionalProperties": {
            "type": "object",
            "required": [
              "description",
              "utm_medium",
              "intended-google-channel"
            ],
            "additionalProperties": false,
            "properties": {
              "description": {
                "type": "string"
              },
              "utm_medium": {
                "$ref": "#/$defs/token"
              },
              "intended-google-channel": {
                "type": "string"
              }
            }
          }
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "provenance": {
          "type": "object",
          "required": [
            "canonical-source",
            "explanation"
          ],
          "properties": {
            "explanation": {
              "type": "string"
            }
          },
          "additionalProperties": {
            "$ref": "#/$defs/provenance-class"
          }
        },
        "references": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uri"
          }
        }
      }
    }
  },
  "properties": {
    "$schema": {
      "type": "string",
      "format": "uri"
    },
    "$id": {
      "type": "string",
      "format": "uri"
    },
    "name": {
      "type": "string"
    },
    "id": {
      "const": "utm"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "status": {
      "enum": [
        "draft",
        "open-for-comment",
        "published",
        "deprecated"
      ]
    },
    "updated-at": {
      "type": "string",
      "format": "date"
    },
    "repository": {
      "type": "string",
      "format": "uri"
    },
    "license": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "principle": {
      "type": "string"
    },
    "inputs": {
      "type": "object",
      "required": [
        "required"
      ],
      "properties": {
        "required": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "optional": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "definitions": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "parameters": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/parameter"
      },
      "minItems": 3
    },
    "minimum-conforming-set": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/parameter-name"
      },
      "contains": {
        "const": "utm_campaign"
      }
    },
    "campaign-naming": {
      "type": "object",
      "required": [
        "rule",
        "precedence",
        "slug-algorithm",
        "constraints"
      ],
      "properties": {
        "rule": {
          "type": "string"
        },
        "precedence": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "slug-algorithm": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "constraints": {
          "type": "object",
          "required": [
            "pattern"
          ],
          "properties": {
            "pattern": {
              "type": "string",
              "format": "regex"
            }
          }
        },
        "must-not-add-unless-part-of-identity": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "examples": {
          "type": "array"
        }
      }
    },
    "value-format": {
      "type": "object"
    },
    "url-assembly": {
      "type": "object",
      "required": [
        "parameter-order",
        "rules"
      ],
      "properties": {
        "parameter-order": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/parameter-name"
          }
        },
        "rules": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "generation": {
      "type": "object",
      "required": [
        "steps",
        "missing-context"
      ],
      "properties": {
        "steps": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "missing-context": {
          "type": "object",
          "required": [
            "behavior",
            "response"
          ],
          "properties": {
            "response": {
              "type": "object",
              "required": [
                "status",
                "missing"
              ],
              "properties": {
                "status": {
                  "const": "requires-context"
                },
                "missing": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    },
    "provenance-classes": {
      "type": "object",
      "required": [
        "google-defined",
        "schemafirst-default",
        "organization-defined"
      ],
      "additionalProperties": {
        "type": "string"
      }
    },
    "organization-profile": {
      "type": "object",
      "required": [
        "extends-value",
        "precedence",
        "permitted",
        "not-permitted"
      ]
    },
    "versioning": {
      "type": "object"
    },
    "sources": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "$ref": "#/$defs/token"
      },
      "additionalProperties": {
        "$ref": "#/$defs/source"
      }
    },
    "references": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "title",
          "url"
        ],
        "properties": {
          "title": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "covers": {
            "type": "string"
          }
        }
      }
    }
  }
}
