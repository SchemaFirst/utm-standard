{
  "$schema": "https://www.schemafirst.org/schemas/utm-source.schema.json",
  "id": "google",
  "registry-version": "0.2.0",
  "status": "draft",
  "display-name": "Google",
  "canonical-source": "google",
  "aliases": [
    "google.com",
    "google_ads",
    "googleads",
    "adwords"
  ],
  "category": "search",
  "contexts": {
    "paid": {
      "description": "Paid search ads.",
      "utm_medium": "cpc",
      "intended-google-channel": "Paid Search"
    },
    "display": {
      "description": "Display and banner ads.",
      "utm_medium": "display",
      "intended-google-channel": "Display"
    }
  },
  "notes": [
    "When Google Ads auto-tagging (GCLID) is enabled, Google Analytics uses auto-tagged values for source and medium. Manual UTMs remain useful for utm_campaign and for traffic where GCLID cannot be used.",
    "Organic search results are not manually tagged."
  ],
  "provenance": {
    "canonical-source": "google-defined",
    "contexts.paid.utm_medium": "google-defined",
    "contexts.display.utm_medium": "google-defined",
    "aliases": "schemafirst-default",
    "explanation": "Google documents `google` / `cpc` as the source / medium for paid search, and lists `display` as a Display channel medium."
  },
  "references": [
    "https://support.google.com/analytics/answer/9756891",
    "https://support.google.com/analytics/answer/15612152",
    "https://support.google.com/analytics/answer/11242870"
  ]
}
